test "the index lists every case"
  expect tree has "open-foundations-0001"
  expect tree has "open-badge-0001"

test "a badge case shows its label"
  at "/?case=badge-0003"
  expect tree has "case"
  expect text "badge" == "Label"

test "a dark butter page applies after load"
  at "/?case=foundations-0001&scheme=dark&theme=butter"
  clock +1
  expect tree has "case"

test "an external link names its new tab"
  at "/?case=link-0004"
  expect tree has "link-Label"

test "a removable token removes on press"
  at "/?case=token-0001"
  expect tree has "case"

test "a layout frame shows its parts"
  at "/?case=layout-0001"
  expect tree has "case"

test "a tooltip case opens its tooltip beside the trigger"
  at "/?case=tooltip-0001"
  clock +1
  expect tree has "case-popover"
  tap "case-popover-trigger" hover
  expect tree has "case-popover"

test "controls change their state"
  at "/?case=playground-0001"
  tap "switch-Wi-Fi"
  expect text "switch-state" == "on"
  type "input-name" "Ada"
  expect text "name-value" == "Ada"
  tap "clear-name"
  expect text "name-value" == ""
  tap "checkbox-I agree"
  expect text "agreed-state" == "agreed"
  tap "radio-team"
  expect text "plan-value" == "team"
  tap "segment-free"
  expect text "view-value" == "free"
  tap "up-count"
  tap "up-count"
  expect text "count-value" == "3"
  tap "button-Save"
  expect text "presses" == "1"

test "a tree row opens, closes and selects"
  at "/?case=playground-0002"
  tap "toggle-src"
  expect text "tree-state" == " "
  tap "toggle-src"
  tap "select-a.ts"
  expect text "tree-state" == "a.ts src"

test "a dialog opens and closes"
  at "/?case=playground-0002"
  tap "open-dialog"
  expect tree has "dialog-body"
  tap "close-pg-dialog"
  clock settle
  tap "open-dialog"
  expect tree has "dialog-body"

test "menus choose an action"
  at "/?case=playground-0002"
  tap "pg-menu-trigger"
  tap "menu-copy"
  expect text "chosen" == "copy"
  tap "context-row" contextmenu
  tap "menu-pin"
  expect text "chosen" == "pin"

test "a row moves by pointer drag"
  at "/?case=playground-0002"
  tap "grip-c" drag 0 -100
  clock settle
  expect text "order" == "c,a,b"

test "the sheet opens"
  at "/?case=playground-0002"
  tap "open-sheet"
  expect tree has "sheet-body"

test "the panel resizes by its handle"
  at "/?case=playground-0002"
  tap "resize-handle" drag 60 0
  expect text "width" == "220"

test "a typeahead filters and picks"
  size 420x1800
  at "/?case=playground-0003"
  type "input-who" "gr"
  expect tree has "who-option-grace"
  tap "who-option-grace"
  expect text "person" == "grace"

test "a tokenizer adds and removes"
  size 420x1800
  at "/?case=playground-0003"
  type "input-tags" "al"
  tap "tags-option-alan"
  expect text "tags" == "ada,alan"
  tap "remove-ada"
  expect text "tags" == "alan"

test "selectors choose one and many"
  size 420x1800
  at "/?case=playground-0003"
  tap "one-trigger"
  tap "one-option-ada"
  expect text "one" == "ada"
  tap "many-trigger"
  tap "many-option-grace"
  expect text "many" == "grace"

test "a date picks from the calendar"
  size 420x1800
  at "/?case=playground-0003"
  tap "open-due"
  tap "month-next"
  tap "day-2026-12-24"
  expect text "date" == "2026-12-24 2026-12"

test "a table sorts, selects and pages"
  size 420x1800
  at "/?case=playground-0003"
  tap "sort-year"
  expect text "table-state" == "year asc "
  tap "sort-year"
  expect text "table-state" == "year desc "
  tap "select-grace"
  expect text "table-state" == "year desc grace"
  tap "select-all"
  expect text "table-state" == "year desc ada,grace,alan"
  tap "page-next"
  expect text "page-value" == "2"

test "a chat message sends with a mention"
  size 420x1400
  at "/?case=playground-0004"
  type "input-composer" "Thanks @grace"
  tap "chat-send"
  expect text "count" == "4"
  expect tree has "msg-4"

test "tool calls fold open"
  size 420x1400
  at "/?case=playground-0004"
  tap "tools-2"
  expect tree has "tools-2"

test "power search adds and removes filters"
  size 420x1400
  at "/?case=playground-0004"
  type "input-ps" "owner:gr"
  tap "ps-value-Grace"
  expect text "filters" == "status=Open,owner=Grace"
  tap "remove-status"
  expect text "filters" == "owner=Grace"

test "the overflow list shows the rest in a menu"
  size 420x1400
  at "/?case=playground-0004"
  tap "tags-more"
  expect tree has "tags-rest"
