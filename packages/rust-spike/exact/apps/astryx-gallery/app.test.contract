test "the index lists every case"
  expect tree has "open-foundations-0001"
  expect tree has "open-badge-0001"

test "a badge case shows its label"
  at "/?case=badge-0003"
  expect tree has "case"
  expect text "badge" == "Label"

test "a dark butter page applies after load"
  at "/?case=foundations-0001&scheme=dark&theme=butter"
  clock +1
  expect tree has "case"

test "an external link names its new tab"
  at "/?case=link-0002"
  expect tree has "link-Read the docs"

test "a removable token removes on press"
  at "/?case=token-0010"
  tap "remove-Design"
  expect tree has "case"

test "a layout frame shows its parts"
  at "/?case=layout-0001"
  expect tree has "case"

test "a tooltip case opens its tooltip beside the trigger"
  at "/?case=tooltip-0001"
  clock +1
  expect tree has "case-popover"
  tap "case-popover-trigger" hover
  expect tree has "case-popover"

test "controls change their state"
  at "/?case=playground-0001"
  tap "switch-Wi-Fi"
  expect text "switch-state" == "on"
  type "input-name" "Ada"
  expect text "name-value" == "Ada"
  tap "clear-name"
  expect text "name-value" == ""
  tap "checkbox-I agree"
  expect text "agreed-state" == "agreed"
  tap "radio-team"
  expect text "plan-value" == "team"
  tap "segment-free"
  expect text "view-value" == "free"
  tap "up-count"
  tap "up-count"
  expect text "count-value" == "3"
  tap "button-Save"
  expect text "presses" == "1"
