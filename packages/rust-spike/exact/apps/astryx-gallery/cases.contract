component PopoverCases
  props
    id: string
  state presses = 0
  action noop
    presses = presses + 1
  view
    for c in popoverCases().filter(c => c.caseId == id) key=c.caseId
      column align-items="center" width=360 height=220 justify-content="center"
        button id="popover-trigger" popovertarget="case-popover" testId="popover-trigger" padding="8px 12px"
          text "Open"
        Popover(id=c.id, label=c.label, placement=c.placement, alignment=c.alignment, padding=c.padding, role=c.role, hasCloseButton=c.hasCloseButton, closeButtonLabel=c.closeButtonLabel, hasLightDismiss=c.hasLightDismiss, still=c.still)
          Text(text="Popover content", type="body", size="", color="primary", weight="", maxLines=0, textWrap="", justify="start", wordBreak="break-word", hasStrikethrough=false, hasTabularNumbers=false)

shape CollapsibleCase
  caseId: string
  title: string
  value: string
  isOpen: bool
  isDisabled: bool
  chevronPosition: string
  density: string
  hasDivider: bool
  still: bool

fn collapsibleCases(): CollapsibleCase[] = [CollapsibleCase(caseId="collapsiblegroup-0001", title="Shipping details", value="a", isOpen=false, isDisabled=false, chevronPosition="end", density="balanced", hasDivider=false, still=true), CollapsibleCase(caseId="collapsiblegroup-0002", title="Shipping details", value="a", isOpen=false, isDisabled=false, chevronPosition="end", density="balanced", hasDivider=false, still=true), CollapsibleCase(caseId="collapsiblegroup-0003", title="Shipping details", value="a", isOpen=true, isDisabled=false, chevronPosition="end", density="balanced", hasDivider=false, still=true), CollapsibleCase(caseId="collapsiblegroup-0004", title="Shipping details", value="a", isOpen=false, isDisabled=true, chevronPosition="end", density="balanced", hasDivider=false, still=true), CollapsibleCase(caseId="collapsiblegroup-0005", title="Shipping details", value="a", isOpen=false, isDisabled=false, chevronPosition="start", density="balanced", hasDivider=false, still=true), CollapsibleCase(caseId="collapsiblegroup-0006", title="Shipping details", value="a", isOpen=false, isDisabled=false, chevronPosition="start", density="balanced", hasDivider=false, still=true), CollapsibleCase(caseId="collapsiblegroup-0007", title="Shipping details", value="a", isOpen=true, isDisabled=true, chevronPosition="end", density="balanced", hasDivider=false, still=true), CollapsibleCase(caseId="collapsiblegroup-0008", title="Shipping details", value="a", isOpen=false, isDisabled=true, chevronPosition="start", density="balanced", hasDivider=false, still=true), CollapsibleCase(caseId="collapsiblegroup-0009", title="Shipping details", value="a", isOpen=true, isDisabled=false, chevronPosition="start", density="balanced", hasDivider=false, still=true)]

component CollapsibleCases
  props
    id: string
  state presses = 0
  action noop
    presses = presses + 1
  view
    for c in collapsibleCases().filter(c => c.caseId == id) key=c.caseId
      view width=320
        Collapsible(title=c.title, value=c.value, isOpen=c.isOpen, isDisabled=c.isDisabled, chevronPosition=c.chevronPosition, density=c.density, hasDivider=c.hasDivider, still=c.still, toggle=noop)
          Text(text="Ships in two business days.", type="body", size="", color="primary", weight="", maxLines=0, textWrap="", justify="start", wordBreak="break-word", hasStrikethrough=false, hasTabularNumbers=false)
