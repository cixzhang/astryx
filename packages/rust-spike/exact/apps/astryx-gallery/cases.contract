component SelectableCardCases
  props
    id: string
  state presses = 0
  action noop
    presses = presses + 1
  action noopB(b: bool)
    presses = presses + 1
  action noopS(t: string)
    presses = presses + 1
  action noopSB(t: string, b: bool)
    presses = presses + 1
  action noopN(n: number)
    presses = presses + 1
  action noopSB2(t: string, b: bool)
    presses = presses + 1
  action noopSO(k: string, before: option<string>)
    presses = presses + 1
  view
    column width="100%" align-items="flex-start"
      for c in selectableCardCases().filter(c => c.caseId == id) key=c.caseId
        view width=280
          SelectableCard(label=c.label, isSelected=c.isSelected, isDisabled=c.isDisabled, padding=c.padding, variant=c.variant, elevation=c.elevation, press=noop)
            FixtureBox()
            FixtureBox()
            FixtureBox()

