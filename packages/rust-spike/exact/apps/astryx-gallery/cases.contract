component TableCases
  props
    id: string
  state presses = 0
  action noop
    presses = presses + 1
  action noopB(b: bool)
    presses = presses + 1
  action noopS(t: string)
    presses = presses + 1
  action noopSB(t: string, b: bool)
    presses = presses + 1
  action noopN(n: number)
    presses = presses + 1
  action noopSB2(t: string, b: bool)
    presses = presses + 1
  action noopSO(k: string, before: option<string>)
    presses = presses + 1
  view
    column width="100%" align-items="flex-start"
      for c in tableCases().filter(c => c.caseId == id) key=c.caseId
        view width="100%"
          Table(label=c.label, columns=c.columns, rows=c.rows, density=c.density, dividers=c.dividers, isStriped=c.isStriped, hasHover=c.hasHover, verticalAlign=c.verticalAlign, textOverflow=c.textOverflow, sortKey=c.sortKey, sortDirection=c.sortDirection, hasSelection=c.hasSelection, selected=c.selected, sort=noopS, toggleRow=noopSB2, toggleAll=noopB, toggleExpand=noopS)

