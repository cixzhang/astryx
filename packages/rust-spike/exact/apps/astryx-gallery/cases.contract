component TextCases
  props
    id: string
  state presses = 0
  action noop
    presses = presses + 1
  view
    for c in textCases().filter(c => c.caseId == id) key=c.caseId
      Text(text=c.text, type=c.type, size=c.size, color=c.color, weight=c.weight, maxLines=c.maxLines, textWrap=c.textWrap, justify=c.justify, wordBreak=c.wordBreak, hasStrikethrough=c.hasStrikethrough, hasTabularNumbers=c.hasTabularNumbers)

shape HeadingCase
  caseId: string
  text: string
  level: number
  accessibilityLevel: number
  weight: string
  color: string
  textWrap: string
  justify: string
  wordBreak: string
  hasStrikethrough: bool

