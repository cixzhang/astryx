component TextCases
  props
    id: string
  state presses = 0
  action noop
    presses = presses + 1
  action noopB(b: bool)
    presses = presses + 1
  action noopS(t: string)
    presses = presses + 1
  action noopSB(t: string, b: bool)
    presses = presses + 1
  action noopN(n: number)
    presses = presses + 1
  action noopSB2(t: string, b: bool)
    presses = presses + 1
  action noopSO(k: string, before: option<string>)
    presses = presses + 1
  view
    column width="100%" align-items="flex-start"
      for c in textCases().filter(c => c.caseId == id) key=c.caseId
        Text(text=c.text, type=c.type, size=c.size, color=c.color, weight=c.weight, maxLines=c.maxLines, textWrap=c.textWrap, justify=c.justify, wordBreak=c.wordBreak, hasStrikethrough=c.hasStrikethrough, hasTabularNumbers=c.hasTabularNumbers)

