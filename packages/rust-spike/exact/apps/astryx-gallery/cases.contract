shape FoundationsCase
  caseId: string

fn foundationsCases(): FoundationsCase[] = [FoundationsCase(caseId="foundations-0001")]

component FoundationsCases
  props
    id: string
  state presses = 0
  action noop
    presses = presses + 1
  view
    for c in foundationsCases().filter(c => c.caseId == id) key=c.caseId
      Swatches()

