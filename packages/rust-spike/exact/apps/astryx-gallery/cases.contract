component CaseView
  props
    id: string
  view
    column
      if id.startsWith("foundations-")
        FoundationsCases(id=id)
      if id.startsWith("text-")
        TextCases(id=id)
      if id.startsWith("heading-")
        HeadingCases(id=id)
      if id.startsWith("icon-")
        IconCases(id=id)
      if id.startsWith("spinner-")
        SpinnerCases(id=id)
      if id.startsWith("kbd-")
        KbdCases(id=id)
      if id.startsWith("divider-")
        DividerCases(id=id)
      if id.startsWith("link-")
        LinkCases(id=id)
      if id.startsWith("badge-")
        BadgeCases(id=id)
      if id.startsWith("avatar-")
        AvatarCases(id=id)
      if id.startsWith("avatargroup-")
        AvatarGroupCases(id=id)
      if id.startsWith("indicator-")
        IndicatorCases(id=id)
      if id.startsWith("stack-")
        StackCases(id=id)
      if id.startsWith("hstack-")
        HStackCases(id=id)
      if id.startsWith("vstack-")
        VStackCases(id=id)
      if id.startsWith("grid-")
        GridCases(id=id)
      if id.startsWith("center-")
        CenterCases(id=id)
      if id.startsWith("aspectratio-")
        AspectRatioCases(id=id)
      if id.startsWith("section-")
        SectionCases(id=id)
      if id.startsWith("card-")
        CardCases(id=id)
      if id.startsWith("layout-")
        LayoutCases(id=id)
      if id.startsWith("emptystate-")
        EmptyStateCases(id=id)
      if id.startsWith("token-")
        TokenCases(id=id)

shape FoundationsCase
  id: string

fn foundationsCases(): FoundationsCase[] = [FoundationsCase(id="foundations-0001")]

component FoundationsCases
  props
    id: string
  state presses = 0
  action noop
    presses = presses + 1
  view
    for c in foundationsCases().filter(c => c.id == id) key=c.id
      Swatches()

