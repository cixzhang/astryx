component GridCases
  props
    id: string
  state presses = 0
  action noop
    presses = presses + 1
  action noopB(b: bool)
    presses = presses + 1
  action noopS(t: string)
    presses = presses + 1
  action noopSB(t: string, b: bool)
    presses = presses + 1
  action noopN(n: number)
    presses = presses + 1
  action noopSB2(t: string, b: bool)
    presses = presses + 1
  action noopSO(k: string, before: option<string>)
    presses = presses + 1
  view
    column width="100%" align-items="flex-start"
      for c in gridCases().filter(c => c.caseId == id) key=c.caseId
        Grid(columns=c.columns, minWidth=c.minWidth, gap=c.gap, rowGap=c.rowGap, columnGap=c.columnGap, align=c.align, justify=c.justify)
          FixtureBox()
          FixtureBox()
          FixtureBox()

shape CenterCase
  caseId: string
  axis: string
  padding: number
  paddingInline: number
  paddingInlineStart: number
  paddingInlineEnd: number
  paddingBlock: number
