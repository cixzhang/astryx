component StackCases
  props
    id: string
  state presses = 0
  action noop
    presses = presses + 1
  action noopB(b: bool)
    presses = presses + 1
  action noopS(t: string)
    presses = presses + 1
  action noopSB(t: string, b: bool)
    presses = presses + 1
  action noopN(n: number)
    presses = presses + 1
  action noopSB2(t: string, b: bool)
    presses = presses + 1
  action noopSO(k: string, before: option<string>)
    presses = presses + 1
  view
    column width="100%" align-items="flex-start"
