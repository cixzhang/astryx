component VStackCases
  props
    id: string
  state presses = 0
  action noop
    presses = presses + 1
  action noopB(b: bool)
    presses = presses + 1
  action noopS(t: string)
    presses = presses + 1
  action noopSB(t: string, b: bool)
    presses = presses + 1
  action noopN(n: number)
    presses = presses + 1
  action noopSB2(t: string, b: bool)
    presses = presses + 1
  action noopSO(k: string, before: option<string>)
    presses = presses + 1
  view
    column width="100%" align-items="flex-start"
      for c in vStackCases().filter(c => c.caseId == id) key=c.caseId
        view width="100%"
          VStack(gap=c.gap, padding=c.padding, paddingInline=c.paddingInline, paddingInlineStart=c.paddingInlineStart, paddingInlineEnd=c.paddingInlineEnd, paddingBlock=c.paddingBlock, paddingBlockStart=c.paddingBlockStart, paddingBlockEnd=c.paddingBlockEnd, hAlign=c.hAlign, vAlign=c.vAlign, align=c.align, justify=c.justify, wrap=c.wrap, isScrollable=c.isScrollable)
            FixtureBox()
            FixtureBox()
            FixtureBox()

