// The app side of Astryx theming: one axis whose values are Astryx themes. Each `when` line is a
// token that theme sets to another value than the default theme. Written by
// tools/astryx-tamber.mjs; an app copies this block into its app.tamber.
axes
  theme = neutral | default | stone | butter | chocolate | gothic | matcha | y2k

theme
  astryx.accent = light-dark(#0064E0, #0171E3)
    when theme=neutral: light-dark(#1b1b1b, #f1f1f1)
    when theme=stone: light-dark(#25252a, #f0f0f9)
    when theme=butter: light-dark(#225bff, #fdee8c)
    when theme=chocolate: light-dark(#8C5927, #d4a06a)
    when theme=gothic: #e8f1f6
    when theme=matcha: light-dark(#3e481d, #c0cba9)
    when theme=y2k: light-dark(#2d241b, #edeffc)
  astryx.accent-muted = light-dark(#0082FB33, #0082FB3F)
    when theme=neutral: light-dark(#d4d4d4, #474747)
    when theme=stone: light-dark(#25252a14, #f0f0f920)
    when theme=butter: light-dark(#225bff33, #fdee8c40)
    when theme=chocolate: light-dark(#8C592714, #d4a06a20)
    when theme=gothic: #e8f1f620
    when theme=matcha: light-dark(#3e481d14, #c0cba920)
    when theme=y2k: light-dark(#2d241b14, #edeffc20)
  astryx.surface.blue = #0171E333
    when theme=neutral: light-dark(#b9d7ff, #253c5a)
    when theme=stone: light-dark(#d3e4fc, #445469)
    when theme=butter: #dbe1ff
    when theme=chocolate: #3a5e8c33
    when theme=gothic: #a3b5d6
    when theme=matcha: #3a5e8c33
